# Copy to .env (gitignored) and replace every value. `docker compose up` reads .env.
#
# Passwords: at least 8 characters with upper case, lower case and digits (SQL Server's
# policy). Use letters and digits only: the service passwords go inside DATABASE_URL and
# init.sql, where characters like @ : / ? # % ' would need escaping.

MSSQL_SA_PASSWORD=ChangeMeSa2026
HOUSEHOLD_DB_PASSWORD=ChangeMeHousehold2026
FAIRNESS_DB_PASSWORD=ChangeMeFairness2026

# Shared by both services: household signs tokens with it, fairness verifies them.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-a-long-random-string
